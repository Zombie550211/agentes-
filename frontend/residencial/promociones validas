.amount }}<\u002Fspan><span class=\"plate plate-y\" aria-hidden=\"true\">{{ p.first.amount }}<\u002Fspan><\u002Fdiv>\n                <span style=\"font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-neutral-700);\">{{ p.first.label }}<\u002Fspan>\n              <\u002Fdiv>\n              <sc-for list=\"{{ p.rest }}\" as=\"it\">\n                <div style=\"grid-column: 1 / -1; display: flex; justify-content: space-between; gap: var(--space-3); font-size: 15px;\"><span>{{ it.label }}<\u002Fspan><span style=\"font-weight: 600;\">{{ it.amount }}<\u002Fspan><\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Farticle>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n    <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ dialogOpen }}\">\n    <div class=\"dialog-backdrop\" sc-camel-on-click=\"{{ closeIfBackdrop }}\" style=\"position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: var(--space-4);\">\n      <form class=\"dialog\" sc-camel-on-submit=\"{{ save }}\" sc-camel-no-validate=\"{{ true }}\" style=\"width: min(100%, 520px); max-height: calc(100vh - 40px); overflow: auto; display: flex; flex-direction: column; gap: var(--space-4);\">\n        <h2 class=\"dialog-title\" style=\"margin: 0;\">{{ dialogTitle }}<\u002Fh2>\n        <div class=\"dialog-body\" style=\"display: flex; flex-direction: column; gap: var(--space-4);\">\n          <label class=\"field\" style=\"display: flex; flex-direction: column; gap: 6px;\">\n            <span>Nombre de la promoción<\u002Fspan>\n            <input class=\"input\" placeholder=\"Ej. Bono por portabilidad\" value=\"{{ draft.title }}\" sc-camel-on-change=\"{{ onTitle }}\">\n            <sc-if value=\"{{ errTitle }}\"><span style=\"font-size: 12px; color: var(--color-accent-2-700);\">{{ errTitle }}<\u002Fspan><\u002Fsc-if>\n          <\u002Flabel>\n          <div style=\"display: flex; flex-direction: column; gap: var(--space-2);\">\n            <div style=\"display: grid; grid-template-columns: minmax(0, 1fr) 120px 36px; gap: var(--space-2); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-neutral-700);\">\n              <span>Concepto<\u002Fspan><span>Monto<\u002Fspan><span><\u002Fspan>\n            <\u002Fdiv>\n            <sc-for list=\"{{ draftItems }}\" as=\"it\">\n              <div style=\"display: grid; grid-template-columns: minmax(0, 1fr) 120px 36px; gap: var(--space-2); align-items: center;\">\n                <input class=\"input\" placeholder=\"Ej. Por línea\" value=\"{{ it.label }}\" sc-camel-on-change=\"{{ it.onLabel }}\">\n                <input class=\"input\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"0\" value=\"{{ it.amount }}\" sc-camel-on-change=\"{{ it.onAmount }}\">\n                <button class=\"btn btn-ghost btn-icon\" type=\"button\" sc-camel-on-click=\"{{ it.remove }}\" disabled=\"{{ it.only }}\" title=\"Quitar monto\"><i class=\"ph-duotone ph-x\" style=\"font-size: 16px;\"><\u002Fi><\u002Fbutton>\n              <\u002Fdiv>\n            <\u002Fsc-for>\n            <sc-if value=\"{{ errItems }}\"><span style=\"font-size: 12px; color: var(--color-accent-2-700);\">{{ errItems }}<\u002Fspan><\u002Fsc-if>\n            <button class=\"btn btn-ghost\" type=\"button\" sc-camel-on-click=\"{{ addItem }}\" style=\"align-self: flex-start;\"><i class=\"ph-duotone ph-plus\" style=\"font-size: 16px;\"><\u002Fi><span>Agregar otro monto<\u002Fspan><\u002Fbutton>\n          <\u002Fdiv>\n          <label style=\"display: flex; align-items: center; gap: var(--space-2); font-size: 15px; cursor: pointer;\">\n            <input type=\"checkbox\" checked=\"{{ draft.featured }}\" sc-camel-on-change=\"{{ onFeatured }}\" style=\"width: 18px; height: 18px; accent-color: var(--color-accent);\">\n            <span>Mostrar como promoción destacada<\u002Fspan>\n          <\u002Flabel>\n        <\u002Fdiv>\n        <div class=\"dialog-actions\" style=\"display: flex; justify-content: flex-end; gap: var(--space-2);\">\n          <button class=\"btn btn-secondary\" type=\"button\" sc-camel-on-click=\"{{ closeDialog }}\">Cancelar<\u002Fbutton>\n          <button class=\"btn btn-primary\" type=\"submit\">{{ saveLabel }}<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fform>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;decimales&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:false,&quot;tsType&quot;:&quot;boolean&quot;}}\">\nconst KEY = 'promociones-activas-v1';\nconst SEED = [\n  { id: 'p1', title: 'Mejor team y mejor supervisor', featured: true, items: [{ label: 'Mejor team', amount: 200 }, { label: 'Mejor supervisor', amount: 100 }] },\n  { id: 'p2', title: 'Todos los gigas menos Xfinity', items: [{ label: 'Por giga', amount: 3 }] },\n  { id: 'p3', title: 'Bono por 23 puntos activos, o más', items: [{ label: 'Bono', amount: 35 }] },\n  { id: 'p4', title: 'Transfer a Líneas y venta efectiva', items: [{ label: 'Por línea', amount: 1 }] },\n];\nconst blank = () => ({ id: null, title: '', featured: false, items: [{ label: '', amount: '' }] });\n\nclass Component extends DCLogic {\n  state = (() => {\n    let promos = SEED;\n    try { const s = JSON.parse(localStorage.getItem(KEY)); if (Array.isArray(s)) promos = s; } catch (e) {}\n    return { promos, editing: false, draft: null, err: {} };\n  })();\n\n  commit(promos) { this.setState({ promos }); try { localStorage.setItem(KEY, JSON.stringify(promos)); } catch (e) {} }\n  setFeatured(promos, id) { return promos.map(p => ({ ...p, featured: p.id === id })); }\n  open = p => this.setState({ draft: p ? JSON.parse(JSON.stringify(p)) : blank(), err: {} });\n  patch = fn => this.setState(s => ({ draft: fn(s.draft), err: {} }));\n  remove = id => {\n    const p = this.state.promos.find(x => x.id === id);\n    if (!window.confirm(`¿Quitar \"${p.title}\"?`)) return;\n    this.commit(this.state.promos.filter(x => x.id !== id));\n  };\n\n  save = e => {\n    e.preventDefault();\n    const d = this.state.draft, err = {};\n    const items = d.items.filter(i => i.amount !== '' && !isNaN(+i.amount)).map(i => ({ label: i.label.trim(), amount: +i.amount }));\n    if (!d.title.trim()) err.title = 'Escribe un nombre.';\n    if (!items.length) err.items = 'Agrega al menos un monto.';\n    if (Object.keys(err).length) return this.setState({ err });\n    const p = { id: d.id || 'p' + Date.now(), title: d.title.trim(), featured: d.featured, items };\n    let promos = d.id ? this.state.promos.map(x => x.id === d.id ? p : x) : [...this.state.promos, p];\n    if (p.featured) promos = this.setFeatured(promos, p.id);\n    this.commit(promos);\n    this.setState({ draft: null });\n  };\n\n  renderVals() {\n    const { promos, editing, draft, err } = this.state;\n    const dec = this.props.decimales ?? false;\n    const m = n => '$' + (dec || n % 1 ? n.toFixed(2).replace('.', ',') : n);\n    const leadP = promos.find(p => p.featured) || promos[0];\n    const view = (p, i) => {\n      const items = p.items.map(it => ({ label: it.label, amount: m(it.amount) }));\n      return {\n        ...p, n: String(i + 1).padStart(2, '0'), first: items[0], rest: items.slice(1),\n        edit: () => this.open(p), remove: () => this.remove(p.id),\n        feature: () => this.commit(this.setFeatured(promos, p.id)),\n      };\n    };\n    const ordered = leadP ? [leadP, ...promos.filter(p => p !== leadP)] : [];\n    const views = ordered.map(view);\n    return {\n      today: new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }),\n      editing, toggleEdit: () => this.setState({ editing: !editing }),\n      editIcon: editing ? 'ph-check' : 'ph-pencil-simple', editLabel: editing ? 'Listo' : 'Editar',\n      openNew: () => this.open(null),\n      hasNone: !promos.length, hasLead: !!leadP, hasSide: views.length > 1,\n      lead: views[0] || { first: {}, rest: [] },\n      side: views.slice(1).map((v, i) => ({ ...v, bg: i % 3 === 1 ? 'var(--color-accent-100)' : 'var(--color-surface)' })),\n      index: views.flatMap(v => [v.first, ...v.rest].map(it => ({ n: v.n, label: it.label || v.title, amount: it.amount }))),\n      dialogOpen: !!draft,\n      dialogTitle: draft && draft.id ? 'Editar promoción' : 'Nueva promoción',\n      saveLabel: draft && draft.id ? 'Guardar cambios' : 'Publicar promoción',\n      draft: draft || blank(),\n      errTitle: err.title, errItems: err.items,\n      onTitle: e => { const v = e.target.value; this.patch(d => ({ ...d, title: v })); },\n      onFeatured: e => { const v = e.target.checked; this.patch(d => ({ ...d, featured: v })); },\n      addItem: () => this.patch(d => ({ ...d, items: [...d.items, { label: '', amount: '' }] })),\n      draftItems: (draft ? draft.items : []).map((it, i, arr) => ({\n        ...it, only: arr.length === 1,\n        onLabel: e => { const v = e.target.value; this.patch(d => ({ ...d, items: d.items.map((x, j) => j === i ? { ...x, label: v } : x) })); },\n        onAmount: e => { const v = e.target.value; this.patch(d => ({ ...d, items: d.items.map((x, j) => j === i ? { ...x, amount: v } : x) })); },\n        remove: () => this.patch(d => ({ ...d, items: d.items.filter((_, j) => j !== i) })),\n      })),\n      closeDialog: () => this.setState({ draft: null }),\n      closeIfBackdrop: e => { if (e.target === e.currentTarget) this.setState({ draft: null }); },\n      save: this.save,\n    };\n  }\n}\n<\u002Fscript>\n\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
