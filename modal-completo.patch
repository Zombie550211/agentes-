--- /dev/null
+++ b/frontend/css/residencial/costumer-edit-glass.css
@@ -0,0 +1,232 @@
+/* ═══════════════════════════════════════════════════════════════════════
+   MODAL "EDITAR CLIENTE" — estilo glassmorphism sobrio
+   ═══════════════════════════════════════════════════════════════════════
+   El contenido del modal se genera en costumer-main.js (toggleRowExpand)
+   con estilos en línea; las clases em-* son los ganchos que usa esta hoja.
+   Por eso aquí hay !important: es la única forma de ganarle a un style="".
+
+   Idea: vidrio esmerilado discreto. La página se ve borrosa detrás, el
+   panel es translúcido con un borde claro que simula el filo del cristal,
+   y las secciones son láminas un poco más opacas. Sin colores saturados:
+   la paleta es la corporativa (marino + dorado) con mucha transparencia.
+   ═══════════════════════════════════════════════════════════════════════ */
+
+:root {
+  --gl-overlay:     rgba(15, 27, 45, .28);
+  --gl-glow-1:      rgba(28, 58, 102, .30);
+  --gl-glow-2:      rgba(184, 146, 58, .18);
+  --gl-panel:       rgba(255, 255, 255, .62);
+  --gl-panel-edge:  rgba(255, 255, 255, .75);
+  --gl-sheet:       rgba(255, 255, 255, .55);
+  --gl-sheet-edge:  rgba(255, 255, 255, .80);
+  --gl-line:        rgba(15, 27, 45, .08);
+  --gl-input:       rgba(255, 255, 255, .72);
+  --gl-input-edge:  rgba(15, 27, 45, .12);
+  --gl-input-focus: rgba(255, 255, 255, .95);
+  --gl-ico-bg:      rgba(28, 58, 102, .08);
+  --gl-ico:         #1c3a66;
+  --gl-shadow:      0 30px 80px rgba(15, 27, 45, .22), 0 2px 6px rgba(15, 27, 45, .06);
+  --gl-sheet-shadow: 0 1px 2px rgba(15, 27, 45, .04), inset 0 1px 0 rgba(255, 255, 255, .6);
+}
+
+body.dark-theme {
+  --gl-overlay:     rgba(4, 8, 16, .45);
+  --gl-glow-1:      rgba(59, 100, 170, .28);
+  --gl-glow-2:      rgba(212, 178, 94, .12);
+  --gl-panel:       rgba(20, 29, 46, .62);
+  --gl-panel-edge:  rgba(255, 255, 255, .10);
+  --gl-sheet:       rgba(255, 255, 255, .04);
+  --gl-sheet-edge:  rgba(255, 255, 255, .08);
+  --gl-line:        rgba(255, 255, 255, .07);
+  --gl-input:       rgba(255, 255, 255, .05);
+  --gl-input-edge:  rgba(255, 255, 255, .12);
+  --gl-input-focus: rgba(255, 255, 255, .09);
+  --gl-ico-bg:      rgba(126, 166, 224, .12);
+  --gl-ico:         #9dbbe8;
+  --gl-shadow:      0 30px 80px rgba(0, 0, 0, .55), 0 2px 6px rgba(0, 0, 0, .3);
+  --gl-sheet-shadow: inset 0 1px 0 rgba(255, 255, 255, .04);
+}
+
+/* ── Fondo: la página borrosa con dos resplandores muy suaves ─────── */
+#editClienteModal {
+  background:
+    radial-gradient(circle at 18% 22%, var(--gl-glow-1), transparent 42%),
+    radial-gradient(circle at 82% 78%, var(--gl-glow-2), transparent 40%),
+    var(--gl-overlay) !important;
+  backdrop-filter: blur(14px) saturate(120%) !important;
+  -webkit-backdrop-filter: blur(14px) saturate(120%) !important;
+}
+
+/* ── Panel de vidrio ──────────────────────────────────────────────── */
+#editClienteDialog {
+  background: var(--gl-panel) !important;
+  backdrop-filter: blur(28px) saturate(140%);
+  -webkit-backdrop-filter: blur(28px) saturate(140%);
+  border: 1px solid var(--gl-panel-edge);
+  border-radius: 20px !important;
+  box-shadow: var(--gl-shadow) !important;
+  overflow: hidden;
+  position: relative;
+}
+/* Reflejo sutil en el borde superior, como el filo de un cristal */
+#editClienteDialog::before {
+  content: '';
+  position: absolute;
+  inset: 0 0 auto 0;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .9), transparent);
+  pointer-events: none;
+}
+body.dark-theme #editClienteDialog::before { background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .18), transparent); }
+
+/* Navegadores sin backdrop-filter: panel opaco para que se lea igual */
+@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
+  #editClienteDialog { background: var(--sheet) !important; }
+  #editClienteModal  { background: rgba(15, 27, 45, .55) !important; }
+}
+
+/* ── Cabecera ─────────────────────────────────────────────────────── */
+#editClienteContent .em-head {
+  border-bottom: 1px solid var(--gl-line) !important;
+  background: linear-gradient(180deg, rgba(255, 255, 255, .35), transparent);
+}
+body.dark-theme #editClienteContent .em-head { background: linear-gradient(180deg, rgba(255, 255, 255, .03), transparent); }
+#editClienteContent .em-head-ico {
+  width: 46px !important; height: 46px !important;
+  background: var(--gl-sheet) !important;
+  border: 1px solid var(--gl-sheet-edge) !important;
+  border-radius: 14px !important;
+  box-shadow: var(--gl-sheet-shadow);
+}
+#editClienteContent .em-head-ico svg { stroke: var(--gl-ico); }
+#editClienteContent .em-title {
+  font-size: 1.12rem !important;
+  font-weight: 700 !important;
+  letter-spacing: -.01em;
+  color: var(--ink-1) !important;
+}
+#editClienteContent .em-subtitle { color: var(--ink-3) !important; }
+
+/* ── Botones ──────────────────────────────────────────────────────── */
+#editClienteContent .em-btn {
+  border-radius: 10px !important;
+  font-family: var(--f) !important;
+  transition: background .15s, border-color .15s, box-shadow .15s;
+}
+#editClienteContent .em-btn-ghost {
+  background: var(--gl-input) !important;
+  border: 1px solid var(--gl-input-edge) !important;
+  color: var(--ink-2) !important;
+  backdrop-filter: blur(8px);
+}
+#editClienteContent .em-btn-ghost:hover { background: var(--gl-input-focus) !important; color: var(--ink-1) !important; }
+#editClienteContent .em-btn-primary {
+  background: var(--navy, #13294b) !important;
+  color: #fff !important;
+  border: 1px solid rgba(255, 255, 255, .12) !important;
+  box-shadow: 0 6px 18px rgba(19, 41, 75, .25), inset 0 1px 0 rgba(255, 255, 255, .12) !important;
+}
+#editClienteContent .em-btn-primary:hover { background: var(--navy-2, #1c3a66) !important; }
+body.dark-theme #editClienteContent .em-btn-primary { background: #1f3a66 !important; box-shadow: 0 6px 18px rgba(0, 0, 0, .35), inset 0 1px 0 rgba(255, 255, 255, .1) !important; }
+#editClienteContent .em-btn-sm { padding: 6px 14px !important; }
+
+/* ── Columnas ─────────────────────────────────────────────────────── */
+#editClienteContent .em-col-l { border-right: 1px solid var(--gl-line) !important; }
+
+/* ── Secciones: láminas de vidrio más opacas ──────────────────────── */
+#editClienteContent .em-sec {
+  background: var(--gl-sheet) !important;
+  border: 1px solid var(--gl-sheet-edge) !important;
+  border-radius: 16px !important;
+  box-shadow: var(--gl-sheet-shadow);
+  padding-left: 22px !important;   /* anula el padding de la franja lateral */
+}
+#editClienteContent .em-sec-ico {
+  background: var(--gl-ico-bg) !important;
+  border-radius: 9px !important;
+}
+#editClienteContent .em-sec-ico svg { stroke: var(--gl-ico); }
+#editClienteContent .em-sec-title {
+  font-size: .68rem !important;
+  font-weight: 700 !important;
+  letter-spacing: .1em !important;
+  color: var(--ink-2) !important;
+}
+
+/* ── Campos ───────────────────────────────────────────────────────── */
+#editClienteContent .em-lbl {
+  font-size: .6rem !important;
+  font-weight: 600 !important;
+  letter-spacing: .09em !important;
+  color: var(--ink-3) !important;
+}
+#editClienteContent .em-input {
+  background: var(--gl-input) !important;
+  border: 1px solid var(--gl-input-edge) !important;
+  border-radius: 10px !important;
+  color: var(--ink-1) !important;
+  font-family: var(--f);
+  transition: background .15s, border-color .15s, box-shadow .15s;
+}
+#editClienteContent .em-input:hover:not(:disabled) { border-color: rgba(28, 58, 102, .28) !important; }
+body.dark-theme #editClienteContent .em-input:hover:not(:disabled) { border-color: rgba(255, 255, 255, .22) !important; }
+#editClienteContent .em-input:focus {
+  outline: none;
+  background: var(--gl-input-focus) !important;
+  border-color: rgba(28, 58, 102, .45) !important;
+  box-shadow: 0 0 0 4px rgba(28, 58, 102, .10) !important;
+}
+body.dark-theme #editClienteContent .em-input:focus {
+  border-color: rgba(126, 166, 224, .5) !important;
+  box-shadow: 0 0 0 4px rgba(126, 166, 224, .12) !important;
+}
+#editClienteContent select.em-input option { background: var(--sheet); color: var(--ink-1); }
+body.dark-theme #editClienteContent input.em-input[type="date"] { color-scheme: dark; }
+#editClienteContent .em-pts { font-family: var(--f-mono) !important; border-radius: 8px !important; }
+
+/* ── Tabla clave/valor (supervisor, motivo, puntaje) ──────────────── */
+#editClienteContent .em-kv {
+  background: var(--gl-input) !important;
+  border: 1px solid var(--gl-input-edge) !important;
+  border-radius: 12px !important;
+}
+#editClienteContent .em-kv > div { border-color: var(--gl-line) !important; }
+
+/* ── Notas ────────────────────────────────────────────────────────── */
+#editClienteContent .em-count {
+  background: var(--gl-ico-bg) !important;
+  border: 1px solid var(--gl-sheet-edge) !important;
+  color: var(--ink-2) !important;
+}
+#editClienteContent .em-note-wrap {
+  background: var(--gl-input) !important;
+  border: 1px solid var(--gl-input-edge) !important;
+  border-radius: 12px !important;
+}
+
+/* ── Captura / contrato ───────────────────────────────────────────── */
+#editClienteContent .em-file {
+  background: var(--gl-input) !important;
+  border: 1px solid var(--gl-input-edge) !important;
+  border-radius: 12px !important;
+}
+#editClienteContent .em-drop {
+  background: var(--gl-input) !important;
+  border: 1.5px dashed var(--gl-input-edge) !important;
+  border-radius: 12px !important;
+}
+#editClienteContent .em-verified {
+  background: rgba(31, 122, 77, .10) !important;
+  color: var(--go, #1f7a4d) !important;
+  border: 1px solid rgba(31, 122, 77, .25) !important;
+}
+
+/* Scroll interno discreto */
+#editClienteModal::-webkit-scrollbar { width: 8px; }
+#editClienteModal::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, .35); border-radius: 8px; }
+
+@media (max-width: 900px) {
+  #editClienteContent .em-body { grid-template-columns: 1fr !important; }
+  #editClienteContent .em-col-l { border-right: none !important; border-bottom: 1px solid var(--gl-line); }
+  #editClienteContent .em-col { padding: 16px !important; }
+}
